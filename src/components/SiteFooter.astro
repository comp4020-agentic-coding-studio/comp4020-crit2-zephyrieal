---
const base = import.meta.env.BASE_URL;
---

<footer class="footer">
  <div class="section section-inner footer__inner">
    <p>
      melonDS is free software under the
      <a href="https://github.com/melonDS-emu/melonDS/blob/master/LICENSE" target="_blank" rel="noopener noreferrer"
        >GPL-3.0 licence</a
      >. This page is an unofficial, unsolicited redesign — the real project
      lives at
      <a href="https://melonds.kuribo64.net/" target="_blank" rel="noopener noreferrer"
        >melonds.kuribo64.net</a
      >.
    </p>
    <nav aria-label="Footer">
      <ul>
        <li><a href={`${base}community/`}>Community</a></li>
        <li>
          <a href="https://github.com/melonDS-emu/melonDS" target="_blank" rel="noopener noreferrer"
            >Source</a
          >
        </li>
      </ul>
    </nav>
  </div>
</footer>

<style>
  .footer {
    background: var(--panel);
    border-top: 1px solid var(--hairline);
  }

  .footer__inner {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 1.5rem;
  }

  .footer p {
    color: var(--text-muted);
    font-size: 0.88rem;
    max-width: 34rem;
  }

  .footer nav ul {
    display: flex;
    gap: 1.5rem;
    list-style: none;
    margin: 0;
    padding: 0;
    font-size: 0.88rem;
  }
</style>
