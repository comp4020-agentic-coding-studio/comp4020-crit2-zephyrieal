---
const base = import.meta.env.BASE_URL;

const links = [
  { href: `${base}#features`, label: "Features" },
  { href: `${base}#downloads`, label: "Downloads" },
  { href: `${base}screenshots/`, label: "Screenshots" },
  { href: `${base}faq/`, label: "FAQ" },
  { href: `${base}blog/`, label: "Blog" },
  { href: `${base}community/`, label: "Community" },
  { href: `${base}forum/`, label: "Forum" },
];
---

<header class="header">
  <div class="header__inner">
    <a class="header__brand" href={import.meta.env.BASE_URL}>
      <img
        class="header__logo"
        src={`${base}melon/melonbanner2.png`}
        width="656"
        height="150"
        alt="melonDS — DS emulator, sorta"
      />
    </a>
    <button class="header__toggle" type="button" aria-expanded="false" aria-controls="primary-nav" aria-label="Toggle navigation" data-nav-toggle>
      <span></span>
      <span></span>
      <span></span>
    </button>
    <nav id="primary-nav" aria-label="Primary">
      <ul>
        {
          links.map((link) => (
            <li>
              <a href={link.href}>{link.label}</a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 10;
    background: color-mix(in srgb, var(--shell) 92%, transparent);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--hairline);
    padding: 0 var(--gutter);
  }

  .header__inner {
    max-width: var(--content-max);
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1.1rem 0;
    gap: 1.5rem;
  }

  .header__brand {
    display: flex;
    align-items: center;
    flex-shrink: 0;
  }

  .header__logo {
    height: 2.5rem;
    width: auto;
  }

  .header__toggle {
    display: none;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    width: 2.25rem;
    height: 2.25rem;
    margin-left: auto;
    padding: 0;
    background: none;
    border: 1px solid var(--hairline);
    border-radius: var(--radius-sm);
    cursor: var(--cursor-watermelon);
  }

  .header__toggle span {
    display: block;
    height: 2px;
    margin-inline: 0.55rem;
    background: var(--text);
    border-radius: 999px;
  }

  nav ul {
    display: flex;
    gap: clamp(1rem, 2vw, 2rem);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  nav a {
    color: var(--text-muted);
    text-decoration: none;
    font-weight: 500;
    font-size: 0.95rem;
  }

  nav a:hover {
    color: var(--text);
  }

  @media (max-width: 640px) {
    .header__toggle {
      display: flex;
    }

    /* Six links plus the logo never fit one row at phone widths, so below
       this breakpoint the nav becomes a toggled dropdown instead of an
       inline row that overflows the viewport. */
    nav {
      display: none;
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      background: var(--shell);
      border-bottom: 1px solid var(--hairline);
      padding: 0.5rem var(--gutter) 1.25rem;
    }

    nav.is-open {
      display: block;
    }

    nav ul {
      flex-direction: column;
      gap: 1rem;
      font-size: 0.95rem;
    }
  }
</style>

<script is:inline>
  const toggle = document.querySelector("[data-nav-toggle]");
  const nav = document.getElementById("primary-nav");

  if (toggle && nav) {
    toggle.addEventListener("click", () => {
      const open = nav.classList.toggle("is-open");
      toggle.setAttribute("aria-expanded", String(open));
    });

    nav.querySelectorAll("a").forEach((link) => {
      link.addEventListener("click", () => {
        nav.classList.remove("is-open");
        toggle.setAttribute("aria-expanded", "false");
      });
    });
  }
</script>
