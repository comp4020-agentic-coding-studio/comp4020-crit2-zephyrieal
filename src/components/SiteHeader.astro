---
const base = import.meta.env.BASE_URL;

const links = [
  { href: `${base}#features`, label: "Features" },
  { href: `${base}#downloads`, label: "Downloads" },
  { href: `${base}screenshots/`, label: "Screenshots" },
  { href: `${base}faq/`, label: "FAQ" },
  { href: `${base}blog/`, label: "Blog" },
  { href: `${base}community/`, label: "Community" },
];
---

<header class="header">
  <div class="header__inner">
    <a class="header__brand" href={import.meta.env.BASE_URL}>
      <img
        class="header__logo"
        src={`${base}melon/melonbanner2.png`}
        width="656"
        height="150"
        alt="melonDS — DS emulator, sorta"
      />
    </a>
    <nav aria-label="Primary">
      <ul>
        {
          links.map((link) => (
            <li>
              <a href={link.href}>{link.label}</a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 10;
    background: color-mix(in srgb, var(--shell) 92%, transparent);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--hairline);
    padding: 0 var(--gutter);
  }

  .header__inner {
    max-width: var(--content-max);
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1.1rem 0;
    gap: 1.5rem;
  }

  .header__brand {
    display: flex;
    align-items: center;
    flex-shrink: 0;
  }

  .header__logo {
    height: 2.5rem;
    width: auto;
  }

  nav ul {
    display: flex;
    gap: clamp(1rem, 2vw, 2rem);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  nav a {
    color: var(--text-muted);
    text-decoration: none;
    font-weight: 500;
    font-size: 0.95rem;
  }

  nav a:hover {
    color: var(--text);
  }

  @media (max-width: 640px) {
    nav ul {
      gap: 1rem;
      font-size: 0.85rem;
    }
  }
</style>
