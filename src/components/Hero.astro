---
const base = import.meta.env.BASE_URL;
---

<section class="hero">
  <div class="hero__panel hero__panel--top">
    <div class="hero__art" aria-hidden="true">
      <img
        class="hero__art-photo"
        src={`${base}backgrounds/ds-lite-cutout.png`}
        width="1400"
        height="1168"
        alt=""
        loading="eager"
        decoding="async"
      />
      <!-- Original decorative silhouettes, not a reproduction of any
           existing character design — generic "handheld-game cast" shapes
           to echo the console photo without touching Nintendo's own IP. -->
      <svg class="hero__art-runner" viewBox="0 0 100 140" fill="var(--glow)">
        <circle cx="50" cy="20" r="16" />
        <rect x="34" y="38" width="32" height="46" rx="14" />
        <path d="M34 60 L14 78 L20 88 L42 72 Z" />
        <path d="M66 60 L90 50 L86 40 L62 52 Z" />
        <path d="M40 82 L26 130 L38 134 L48 92 Z" />
        <path d="M58 82 L74 122 L62 128 L50 92 Z" />
      </svg>
      <svg class="hero__art-companion" viewBox="0 0 100 100" fill="var(--led)">
        <ellipse cx="50" cy="60" rx="34" ry="30" />
        <circle cx="30" cy="24" r="8" />
        <circle cx="70" cy="24" r="8" />
        <circle cx="38" cy="55" r="5" fill="var(--shell)" />
        <circle cx="62" cy="55" r="5" fill="var(--shell)" />
      </svg>
    </div>
    <div class="section-inner hero__content">
      <img
        class="hero__logo"
        src={`${base}melon/melonbanner2.png`}
        width="656"
        height="150"
        alt="melonDS — DS emulator, sorta"
        data-reveal
      />
      <h1 data-reveal style="--reveal-delay: 0.1s">Fast, accurate Nintendo DS emulation.</h1>
      <p class="hero__lede" data-reveal style="--reveal-delay: 0.2s">
        melonDS aims to emulate the Nintendo DS — and DSi — accurately, without
        giving up speed. It's still evolving, but the core is nearly complete,
        with a solid set of features already in place.
      </p>
      <div class="hero__actions" data-reveal style="--reveal-delay: 0.3s">
        <a class="button button-primary" href="#downloads">Download melonDS</a>
        <a class="button button-ghost" href="#features">See what's emulated</a>
      </div>
    </div>
  </div>
</section>

<style>
  .hero__panel {
    padding-block: clamp(3rem, 8vw, 5.5rem);
  }

  .hero__panel--top {
    position: relative;
    background: var(--shell);
    overflow: hidden;
  }

  /* The console (background already cut out, see the PNG's own alpha
     channel) sits behind the copy, and the ::after gradient fades the
     whole art layer into the shell colour at the container's own edges so
     nothing feels pasted on top of a solid block. */
  .hero__art {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
  }

  .hero__art::after {
    content: "";
    position: absolute;
    inset: 0;
    background:
      linear-gradient(
        to right,
        var(--shell) 0%,
        transparent 32%,
        transparent 78%,
        var(--shell) 100%
      ),
      linear-gradient(to bottom, transparent 55%, var(--shell) 100%);
  }

  /* Background already removed from the source photo (chroma-keyed out, not
     just faded), so the console floats free rather than sitting in a
     rectangle — a drop-shadow gives it depth instead of the mask this used
     to need to hide a photo backdrop. */
  .hero__art-photo {
    position: absolute;
    top: 50%;
    right: clamp(-4rem, -1vw, 2rem);
    transform: translateY(-50%);
    width: clamp(22rem, 40vw, 34rem);
    height: auto;
    opacity: 0.95;
    filter:
      grayscale(0.5) sepia(0.35) hue-rotate(58deg) saturate(1.6)
      brightness(0.65) contrast(1.05)
      drop-shadow(0 25px 45px rgb(0 0 0 / 45%));
    display: none;
  }

  .hero__art-runner,
  .hero__art-companion {
    position: absolute;
    display: none;
  }

  .hero__art-runner {
    right: 9%;
    bottom: 8%;
    width: clamp(3.5rem, 6vw, 5.5rem);
    height: auto;
    opacity: 0.16;
  }

  .hero__art-companion {
    right: 24%;
    top: 14%;
    width: clamp(2.5rem, 4vw, 4rem);
    height: auto;
    opacity: 0.13;
  }

  @media (min-width: 800px) {
    .hero__art-photo,
    .hero__art-runner,
    .hero__art-companion {
      display: block;
    }
  }

  /* Padding lives on the same box as the max-width/centering (like
     .section + .section-inner elsewhere), so the heading's left edge
     lands at the same x as Features/Downloads instead of drifting by
     one gutter when the two responsibilities are split across elements. */
  .hero__content {
    position: relative;
    z-index: 1;
    padding-inline: var(--gutter);
  }

  @media (min-width: 900px) {
    .hero__content > * {
      max-width: 34rem;
    }
  }

  .hero__logo {
    width: clamp(16rem, 42vw, 34rem);
    height: auto;
    margin-bottom: clamp(1.5rem, 4vw, 2.5rem);
  }

  h1 {
    font-size: clamp(2.4rem, 5vw, 3.75rem);
    letter-spacing: -0.01em;
  }

  .hero__lede {
    margin-top: 1.5rem;
    font-size: 1.15rem;
    color: var(--text-muted);
    max-width: 34rem;
  }

  .hero__actions {
    margin-top: 2.25rem;
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
  }
</style>
