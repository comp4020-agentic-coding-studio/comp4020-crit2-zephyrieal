---
// The site's signature: a literal two-screen, hinged DS. One instance, pinned
// as you scroll and swapping what's on its screens to match the section
// passing by, at every viewport — a side column on desktop, a banner pinned
// under the header on mobile. Every screen is an illustrative render, not a
// capture of anything real — same honesty rule as the rest of this redesign.
interface Props {
  activeVariant?: "hero" | "features" | "downloads";
}

const { activeVariant = "hero" } = Astro.props;
---

<div class="ds-device" data-ds-device="sticky" data-active-variant={activeVariant}>
  <div class="ds-device__frame">
    <div class="ds-screen ds-screen--top">
      <svg class="ds-art" data-variant="hero" viewBox="0 0 200 140" role="presentation">
        <defs>
          <linearGradient id="ds-sky" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0%" stop-color="var(--panel-raised)" />
            <stop offset="100%" stop-color="var(--shell)" />
          </linearGradient>
        </defs>
        <rect width="200" height="140" fill="url(#ds-sky)" />
        <circle cx="152" cy="34" r="16" fill="var(--glow)" opacity="0.55" />
        <polygon points="0,140 44,66 88,140" fill="var(--panel)" />
        <polygon points="56,140 108,42 160,140" fill="var(--panel-raised)" />
        <polygon points="112,140 164,74 200,140" fill="var(--panel)" />
        <rect x="0" y="128" width="200" height="12" fill="var(--led)" opacity="0.85" />
      </svg>
      <svg class="ds-art" data-variant="features" viewBox="0 0 200 140" role="presentation">
        <rect width="200" height="140" fill="var(--panel)" />
        <polygon points="70,30 130,30 150,60 100,80 50,60" fill="none" stroke="var(--glow)" stroke-width="1.5" />
        <polygon points="50,60 100,80 100,120 50,100" fill="none" stroke="var(--glow)" stroke-width="1.5" opacity="0.7" />
        <polygon points="100,80 150,60 150,100 100,120" fill="none" stroke="var(--glow)" stroke-width="1.5" opacity="0.45" />
        <circle cx="70" cy="30" r="2.5" fill="var(--glow)" />
        <circle cx="130" cy="30" r="2.5" fill="var(--glow)" />
        <circle cx="150" cy="60" r="2.5" fill="var(--glow)" />
        <circle cx="150" cy="100" r="2.5" fill="var(--glow)" />
        <circle cx="100" cy="120" r="2.5" fill="var(--glow)" />
        <circle cx="50" cy="100" r="2.5" fill="var(--glow)" />
        <circle cx="50" cy="60" r="2.5" fill="var(--glow)" />
      </svg>
      <svg class="ds-art" data-variant="downloads" viewBox="0 0 200 140" role="presentation">
        <rect width="200" height="140" fill="var(--panel)" />
        <rect x="26" y="26" width="62" height="40" rx="6" fill="var(--panel-raised)" stroke="var(--hairline)" />
        <rect x="112" y="26" width="62" height="40" rx="6" fill="var(--panel-raised)" stroke="var(--hairline)" opacity="0.85" />
        <rect x="26" y="80" width="62" height="34" rx="6" fill="var(--panel-raised)" stroke="var(--hairline)" opacity="0.7" />
        <rect x="112" y="80" width="62" height="34" rx="6" fill="var(--panel-raised)" stroke="var(--hairline)" opacity="0.55" />
        <circle cx="57" cy="46" r="7" fill="var(--glow)" />
        <circle cx="143" cy="46" r="7" fill="var(--glow)" opacity="0.85" />
        <circle cx="57" cy="97" r="6" fill="var(--led)" opacity="0.8" />
        <circle cx="143" cy="97" r="6" fill="var(--led)" opacity="0.6" />
      </svg>
    </div>

    <div class="ds-device__hinge" role="presentation">
      <span class="ds-device__seam"></span>
    </div>

    <div class="ds-screen ds-screen--bottom">
      <svg class="ds-art" data-variant="hero" viewBox="0 0 200 140" role="presentation">
        <rect width="200" height="140" fill="var(--panel)" />
        <circle cx="100" cy="70" r="10" fill="var(--glow)" opacity="0.9" />
        <circle cx="100" cy="70" r="22" fill="none" stroke="var(--glow)" stroke-width="1.5" opacity="0.5" />
        <circle cx="100" cy="70" r="36" fill="none" stroke="var(--glow)" stroke-width="1.5" opacity="0.25" />
        <circle cx="46" cy="34" r="3" fill="var(--text-muted)" opacity="0.6" />
        <circle cx="154" cy="34" r="3" fill="var(--text-muted)" opacity="0.6" />
        <circle cx="46" cy="106" r="3" fill="var(--text-muted)" opacity="0.6" />
        <circle cx="154" cy="106" r="3" fill="var(--text-muted)" opacity="0.6" />
      </svg>
      <svg class="ds-art" data-variant="features" viewBox="0 0 200 140" role="presentation">
        <rect width="200" height="140" fill="var(--panel)" />
        <rect x="40" y="58" width="16" height="16" fill="var(--glow)" />
        <rect x="24" y="74" width="16" height="16" fill="var(--glow)" />
        <rect x="56" y="74" width="16" height="16" fill="var(--glow)" />
        <rect x="40" y="90" width="16" height="16" fill="var(--glow)" />
        <circle cx="140" cy="66" r="10" fill="none" stroke="var(--led)" stroke-width="2" />
        <circle cx="166" cy="92" r="10" fill="none" stroke="var(--led)" stroke-width="2" opacity="0.7" />
      </svg>
      <svg class="ds-art" data-variant="downloads" viewBox="0 0 200 140" role="presentation">
        <rect width="200" height="140" fill="var(--panel)" />
        <rect x="90" y="30" width="20" height="52" fill="var(--glow)" />
        <polygon points="70,72 100,102 130,72" fill="var(--glow)" />
        <rect x="56" y="112" width="88" height="12" rx="3" fill="var(--panel-raised)" stroke="var(--hairline)" />
      </svg>
    </div>
  </div>

  <p class="ds-device__caption">Illustrative renders, not real captures.</p>
</div>

<style>
  .ds-device__frame {
    background: var(--shell);
    border: 1px solid var(--hairline);
    border-radius: var(--radius);
    padding: 1rem;
    box-shadow: 0 0 60px -10px var(--glow-dim);
  }

  .ds-screen {
    position: relative;
    aspect-ratio: 10 / 7;
    border-radius: var(--radius-sm);
    overflow: hidden;
    background: var(--panel);
  }

  .ds-art {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
    opacity: 0;
  }

  .ds-device[data-active-variant="hero"] .ds-art[data-variant="hero"],
  .ds-device[data-active-variant="features"] .ds-art[data-variant="features"],
  .ds-device[data-active-variant="downloads"] .ds-art[data-variant="downloads"] {
    opacity: 1;
  }

  @media (prefers-reduced-motion: no-preference) {
    .ds-art {
      transition: opacity 0.5s ease;
    }
  }

  .ds-device__hinge {
    height: 1.1rem;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ds-device__seam {
    width: 55%;
    height: 2px;
    background: var(--hairline);
  }

  .ds-device__caption {
    margin-top: 0.85rem;
    font-size: 0.78rem;
    color: var(--text-muted);
    text-align: center;
  }

  .ds-device {
    position: sticky;
    top: 5.5rem;
    z-index: 5;
    max-width: 22rem;
    margin: 0 auto;
  }

  @media (min-width: 1024px) {
    .ds-device {
      top: 50%;
      transform: translateY(-50%);
      max-width: none;
      margin: 0;
    }
  }
</style>

<script>
  const stickyDevices = document.querySelectorAll('[data-ds-device="sticky"]');
  const sections = document.querySelectorAll("[data-ds-section]");

  if (stickyDevices.length && sections.length) {
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          const variant = entry.target.getAttribute("data-ds-section");
          if (!variant) continue;
          for (const device of stickyDevices) {
            device.setAttribute("data-active-variant", variant);
          }
        }
      },
      { rootMargin: "-45% 0px -45% 0px" },
    );

    for (const section of sections) {
      observer.observe(section);
    }
  }
</script>
