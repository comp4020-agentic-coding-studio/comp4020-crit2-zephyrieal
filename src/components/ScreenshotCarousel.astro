---
// The site's signature slot, now the real thing: melonds.kuribo64.net's own
// homepage carousel (js/carousel.js — an <img> that cycles through numbered
// screenshots, preloading the next one and looping back to 0 once a number
// 404s), ported here with the same algorithm and the same 7 real screenshots
// pulled from that script, rather than an illustrative stand-in for it.
const base = import.meta.env.BASE_URL;
---

<div class="carousel" data-carousel>
  <div class="carousel__frame">
    <img
      class="carousel__img"
      src={`${base}melon/carousel/carousel0.png`}
      width="272"
      height="442"
      alt="melonDS running a game, cycling through screenshots"
    />
  </div>
  <p class="carousel__caption">
    The real carousel from melonds.kuribo64.net's homepage — same screenshots, same loop.
  </p>
</div>

<style>
  .carousel {
    position: sticky;
    top: 5.5rem;
    z-index: 5;
    max-width: 22rem;
    margin: 0 auto;
  }

  @media (min-width: 1024px) {
    .carousel {
      top: 50%;
      transform: translateY(-50%);
      max-width: none;
      margin: 0;
    }
  }

  .carousel__frame {
    background: var(--shell);
    border: 1px solid var(--hairline);
    border-radius: var(--radius);
    padding: 1rem;
    box-shadow: 0 0 60px -10px var(--glow-dim);
  }

  .carousel__img {
    width: 100%;
    height: auto;
    border-radius: var(--radius-sm);
  }

  .carousel__caption {
    margin-top: 0.85rem;
    font-size: 0.78rem;
    color: var(--text-muted);
    text-align: center;
  }
</style>

<script define:vars={{ base }} is:inline>
  // Same algorithm as the real site's carousel.js: swap in the next numbered
  // screenshot, preload the one after that, and only advance once it's
  // loaded — a 404 on the preload is how the real script (and this one)
  // finds the end of the sequence and loops back to 0, so no image count is
  // hardcoded on either side.
  const img = document.querySelector('[data-carousel] .carousel__img');
  const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  if (img && !reduceMotion) {
    const path = `${base}melon/carousel/carousel`;

    const advance = (num) => {
      img.src = `${path}${num}.png`;
      const next = new Image();
      next.onload = () => setTimeout(() => advance(num + 1), 5000);
      next.onerror = () => setTimeout(() => advance(0), 5000);
      next.src = `${path}${num + 1}.png`;
    };

    setTimeout(() => advance(1), 5000);
  }
</script>
