---
// Stylised glyphs, not the platforms' actual trademarked logos — same
// illustrative-render rule this redesign applies elsewhere (the screenshots
// page uses real captures, but third-party OS logos are a trademark
// concern real screenshots aren't). Drawn flat in the site's own line-art
// language so they sit next to melonDS's own iconography without looking
// borrowed from anywhere else.
interface Props {
  name: "Windows" | "macOS" | "Linux";
}

const { name } = Astro.props;
---

<span class="platform-icon" aria-hidden="true">
  {
    name === "Windows" && (
      <svg viewBox="0 0 24 24" fill="none">
        <rect x="2" y="2" width="9" height="9" fill="var(--glow)" />
        <rect x="13" y="2" width="9" height="9" fill="var(--glow)" opacity="0.7" />
        <rect x="2" y="13" width="9" height="9" fill="var(--glow)" opacity="0.7" />
        <rect x="13" y="13" width="9" height="9" fill="var(--glow)" opacity="0.45" />
      </svg>
    )
  }
  {
    name === "macOS" && (
      <svg viewBox="0 0 24 24" fill="none">
        <path
          d="M16.6 12.9c0-2.7 2.2-4 2.3-4.1-1.3-1.8-3.2-2.1-3.9-2.1-1.7-.2-3.2 1-4.1 1s-2.2-1-3.6-1c-1.9 0-3.6 1.1-4.6 2.7-2 3.4-.5 8.5 1.4 11.3.9 1.4 2 2.9 3.5 2.9 1.4-.1 1.9-.9 3.6-.9s2.1.9 3.6.9c1.5 0 2.4-1.4 3.3-2.7.7-1.1 1.3-2.3 1.3-2.4 0-.1-3.8-1.5-3.8-5.6z"
          fill="var(--glow)"
        />
        <path d="M13.9 5c.7-.9 1.2-2.1 1.1-3.3-1.1 0-2.4.7-3.1 1.6-.7.8-1.3 2-1.1 3.2 1.2.1 2.4-.6 3.1-1.5z" fill="var(--glow)" opacity="0.7" />
      </svg>
    )
  }
  {
    name === "Linux" && (
      <svg viewBox="0 0 24 24" fill="none">
        <ellipse cx="12" cy="13" rx="6" ry="8" fill="var(--glow)" opacity="0.85" />
        <ellipse cx="12" cy="15" rx="3.4" ry="4.2" fill="var(--shell)" />
        <circle cx="10" cy="9" r="1.1" fill="var(--shell)" />
        <circle cx="14" cy="9" r="1.1" fill="var(--shell)" />
        <polygon points="12,11 10.7,13 13.3,13" fill="var(--led)" />
        <polygon points="7,21 9,17.5 10.5,21" fill="var(--glow)" opacity="0.85" />
        <polygon points="17,21 15,17.5 13.5,21" fill="var(--glow)" opacity="0.85" />
      </svg>
    )
  }
</span>

<style>
  .platform-icon {
    display: inline-flex;
    width: 1.6rem;
    height: 1.6rem;
  }

  .platform-icon svg {
    width: 100%;
    height: 100%;
  }
</style>
