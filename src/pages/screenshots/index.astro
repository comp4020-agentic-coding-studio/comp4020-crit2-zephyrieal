---
import Layout from "../../layouts/Layout.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import HingeDivider from "../../components/HingeDivider.astro";

// Illustrative panels, not captured screenshots — this redesign doesn't have
// rights to real in-emulator captures, so each panel is honestly labelled as
// a stylised render of what the feature does rather than a screenshot of it.
const panels = [
  {
    title: "Upscaled 3D rendering",
    body: "The OpenGL renderer pushes the DS's 3D output well past its native resolution.",
    colors: ["#2b3a55", "#7fe0ff"],
  },
  {
    title: "Flexible screen layouts",
    body: "Position, size, and rotate the two screens independently instead of a fixed stack.",
    colors: ["#1d2129", "#ffa857"],
  },
  {
    title: "Savestates",
    body: "Snapshot a session and return to the exact same moment later.",
    colors: ["#262b35", "#7fe0ff"],
  },
];
---

<Layout title="Screenshots — melonDS" description="Stylised renders of what melonDS's rendering, layout, and savestate features look like in practice.">
  <SiteHeader />
  <main>
    <section class="intro">
      <div class="section section-inner">
        <span class="eyebrow">Screenshots</span>
        <h1>What it looks like in practice.</h1>
        <p class="intro__lede">
          These are stylised renders built for this redesign, not captured
          screenshots — they illustrate what each feature does rather than
          showing a specific game running.
        </p>
      </div>
    </section>
    <HingeDivider />
    <section class="gallery">
      <div class="section section-inner">
        <ul class="gallery__grid">
          {
            panels.map((p) => (
              <li class="panel">
                <div class="panel__frame">
                  <svg viewBox="0 0 320 200" role="img" aria-label={`Stylised illustration: ${p.title}`}>
                    <rect width="320" height="200" fill={p.colors[0]} />
                    <circle cx="240" cy="50" r="26" fill={p.colors[1]} opacity="0.5" />
                    <polygon points="0,200 90,80 180,200" fill="#00000030" />
                    <polygon points="120,200 220,60 320,200" fill="#00000020" />
                  </svg>
                </div>
                <h2>{p.title}</h2>
                <p>{p.body}</p>
              </li>
            ))
          }
        </ul>
      </div>
    </section>
  </main>
  <SiteFooter />
</Layout>

<style>
  .intro {
    background: var(--shell);
  }

  h1 {
    font-size: clamp(2rem, 4vw, 3rem);
    max-width: 32rem;
    margin-top: 0.5rem;
  }

  .intro__lede {
    margin-top: 1rem;
    color: var(--text-muted);
    max-width: 32rem;
  }

  .gallery {
    background: var(--panel);
  }

  .gallery__grid {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
  }

  .panel__frame {
    border-radius: var(--radius);
    overflow: hidden;
    border: 1px solid var(--hairline);
  }

  .panel__frame svg {
    display: block;
    width: 100%;
  }

  .panel h2 {
    margin-top: 1rem;
    font-size: 1.05rem;
    font-family: var(--font-body);
    font-weight: 700;
  }

  .panel p {
    margin-top: 0.4rem;
    color: var(--text-muted);
    font-size: 0.9rem;
  }

  @media (max-width: 900px) {
    .gallery__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
