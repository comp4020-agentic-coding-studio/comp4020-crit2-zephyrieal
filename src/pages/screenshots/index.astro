---
import Layout from "../../layouts/Layout.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import HingeDivider from "../../components/HingeDivider.astro";
import PageIntroArt from "../../components/PageIntroArt.astro";

const base = import.meta.env.BASE_URL;

// Real in-emulator captures, sourced from melonDS's own screenshots page
// (melonds.kuribo64.net/screenshots.php) — a reversal of this redesign's
// earlier illustrative-panels approach, at the user's explicit request.
const panels = [
  { file: "melonds1.png", title: "New Super Mario Bros.", body: "Overworld map, upper and lower screens stacked." },
  { file: "melonds4.png", title: "Super Mario 64 DS", body: "3D platforming rendered through the OpenGL renderer." },
  { file: "melonds3.png", title: "Mario Kart DS", body: "Split-screen racing HUD across both screens." },
  { file: "melonds7.png", title: "Mario Kart DS", body: "In-race view, touch-screen map on the bottom." },
  { file: "melonDS8.png", title: "Scribblenauts", body: "Touch-driven object spawning and physics." },
  { file: "scribbleshiz.png", title: "Tongari Bōshi to Oshare na Mahōtsukai", body: "Title screen." },
  { file: "tongari.png", title: "Tongari Bōshi to Oshare na Mahōtsukai", body: "In-game dialogue scene." },
  { file: "tongari3.png", title: "Tongari Bōshi to Oshare na Mahōtsukai", body: "Field exploration view." },
];
---

<Layout title="Screenshots — melonDS" description="Real in-emulator captures showing melonDS running a range of commercial DS titles.">
  <SiteHeader />
  <main>
    <section class="intro">
      <PageIntroArt />
      <div class="section section-inner">
        <span class="eyebrow" data-reveal>Screenshots</span>
        <h1 data-reveal style="--reveal-delay: 0.1s">What it looks like in practice.</h1>
        <p class="intro__lede" data-reveal style="--reveal-delay: 0.15s">
          Real captures of melonDS running a range of commercial titles,
          straight off the emulator's own screens.
        </p>
      </div>
    </section>
    <HingeDivider />
    <section class="gallery">
      <div class="section section-inner">
        <ul class="gallery__grid">
          {
            panels.map((p, i) => (
              <li class="panel" data-reveal style={`--reveal-delay: ${0.05 * (i % 4)}s`}>
                <div class="panel__frame">
                  <img src={`${base}melon/${p.file}`} width="272" height="422" alt={`melonDS running ${p.title}`} loading="lazy" />
                </div>
                <h2>{p.title}</h2>
                <p>{p.body}</p>
              </li>
            ))
          }
        </ul>
      </div>
    </section>
  </main>
  <SiteFooter />
</Layout>

<style>
  .intro {
    position: relative;
    overflow: hidden;
    background-color: var(--shell);
    background-image: var(--bg-motif);
    background-repeat: repeat;
    background-size: 96px 96px;
  }

  h1 {
    font-size: clamp(2rem, 4vw, 3rem);
    max-width: 32rem;
    margin-top: 0.5rem;
  }

  .intro__lede {
    margin-top: 1rem;
    color: var(--text-muted);
    max-width: 32rem;
  }

  .gallery {
    background-color: var(--panel);
    background-image: var(--bg-motif);
    background-repeat: repeat;
    background-size: 96px 96px;
  }

  .gallery__grid {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.5rem;
  }

  .panel__frame {
    border-radius: var(--radius);
    overflow: hidden;
    border: 1px solid var(--hairline);
    background: var(--shell);
  }

  .panel__frame img {
    display: block;
    width: 100%;
    height: auto;
  }

  .panel h2 {
    margin-top: 1rem;
    font-size: 1.05rem;
    font-family: var(--font-body);
    font-weight: 700;
  }

  .panel p {
    margin-top: 0.4rem;
    color: var(--text-muted);
    font-size: 0.9rem;
  }

  @media (max-width: 900px) {
    .gallery__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 560px) {
    .gallery__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
