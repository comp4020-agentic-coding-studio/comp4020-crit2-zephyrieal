---
import Layout from "../layouts/Layout.astro";
import RedesignNotice from "../components/RedesignNotice.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import Hero from "../components/Hero.astro";
import HingeDivider from "../components/HingeDivider.astro";
import Features from "../components/Features.astro";
import Downloads from "../components/Downloads.astro";
import ScreenshotCarousel from "../components/ScreenshotCarousel.astro";
import FaqTeaser from "../components/FaqTeaser.astro";
---

<Layout title="melonDS — a Nintendo DS emulator">
  <RedesignNotice />
  <SiteHeader />
  <main>
    <div class="stage">
      <div class="stage__hero">
        <Hero />
      </div>
      <div class="stage__visual">
        <ScreenshotCarousel />
      </div>
      <div class="stage__content">
        <HingeDivider />
        <Features />
        <HingeDivider />
        <Downloads />
      </div>
    </div>
    <HingeDivider />
    <FaqTeaser />
  </main>
  <SiteFooter />
</Layout>

<style>
  .stage {
    display: grid;
    grid-template-columns: 1fr;
  }

  @media (max-width: 1023.98px) {
    /* DOM order alone (hero, visual, content) puts the carousel right after
       the intro heading/lede and before Features/Downloads on the
       single-column mobile layout — no reordering needed here. */
    .stage__visual {
      padding: 1.5rem var(--gutter);
    }
  }

  @media (min-width: 1024px) {
    /* Full-bleed: the stage itself isn't capped to the site's content-max,
       so the two columns use the whole viewport width like the original
       desktop layout did. Named areas (not DOM order) place hero/content
       in the left column stacked in two rows, with visual spanning both
       rows in the right column — independent of the source order used for
       the mobile layout above. */
    .stage {
      grid-template-columns: 1fr 32rem;
      grid-template-areas:
        "hero    visual"
        "content visual";
    }

    .stage__hero {
      grid-area: hero;
    }

    .stage__content {
      grid-area: content;
    }

    /* The carousel sticks and self-centers inside THIS box: height:100vh
       plus top:0 makes the sticky element's own layout box exactly what's
       rendered (centering the carousel is a plain flex child, not a
       transform on it), so the sticky engine's "has this run out of room"
       math matches what's on screen. It only releases once this box's own
       bottom edge — the true end of Downloads — scrolls into view, instead
       of releasing early the way a top:50vh + translateY(-50%) transform
       on the carousel itself did (the sticky release calc uses the
       pre-transform box, which is taller than what's actually visible). */
    .stage__visual {
      grid-area: visual;
      position: sticky;
      top: 0;
      height: 100vh;
      display: flex;
      align-items: center;
      padding: 3rem var(--gutter) 3rem 0;
      z-index: 5;
    }
  }
</style>
