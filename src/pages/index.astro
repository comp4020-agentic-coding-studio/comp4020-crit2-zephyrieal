---
import Layout from "../layouts/Layout.astro";
import RedesignNotice from "../components/RedesignNotice.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import Hero from "../components/Hero.astro";
import HingeDivider from "../components/HingeDivider.astro";
import Features from "../components/Features.astro";
import Downloads from "../components/Downloads.astro";
import ScreenshotCarousel from "../components/ScreenshotCarousel.astro";
import FaqTeaser from "../components/FaqTeaser.astro";
---

<Layout title="melonDS — a Nintendo DS emulator">
  <RedesignNotice />
  <SiteHeader />
  <main>
    <div class="stage">
      <div class="stage__content">
        <Hero />
        <HingeDivider />
        <Features />
        <HingeDivider />
        <Downloads />
      </div>
      <div class="stage__visual">
        <ScreenshotCarousel />
      </div>
    </div>
    <HingeDivider />
    <FaqTeaser />
  </main>
  <SiteFooter />
</Layout>

<style>
  .stage {
    display: grid;
    grid-template-columns: 1fr;
  }

  @media (max-width: 1023.98px) {
    /* Hoists the carousel above the content it's meant to be pinned over —
       otherwise, as the second element in document order, it would render
       below all three sections on a single-column mobile layout. */
    .stage__visual {
      order: -1;
      padding: 1.5rem var(--gutter) 0;
    }
  }

  @media (min-width: 1024px) {
    /* Matches the same content-max + gutter box every standalone page's
       .section-inner uses (Screenshots, Downloads, FAQ, Blog, Community),
       so splitting into two columns here doesn't leave the homepage's own
       content starting at a different x than any other page's does. */
    .stage {
      max-width: var(--content-max);
      margin: 0 auto;
      padding-inline: var(--gutter);
      grid-template-columns: 1fr 20rem;
      column-gap: 2rem;
    }

    /* The carousel sticks and self-centers inside THIS box: height:100vh
       plus top:0 makes the sticky element's own layout box exactly what's
       rendered (centering the carousel is a plain flex child, not a
       transform on it), so the sticky engine's "has this run out of room"
       math matches what's on screen. It only releases once this box's own
       bottom edge — the true end of Downloads — scrolls into view, instead
       of releasing early the way a top:50vh + translateY(-50%) transform
       on the carousel itself did (the sticky release calc uses the
       pre-transform box, which is taller than what's actually visible). */
    .stage__visual {
      position: sticky;
      top: 0;
      height: 100vh;
      display: flex;
      align-items: center;
      padding-block: 3rem;
      z-index: 5;
    }
  }
</style>
