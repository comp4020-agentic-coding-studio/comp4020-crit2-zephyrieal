---
import Layout from "../layouts/Layout.astro";
import RedesignNotice from "../components/RedesignNotice.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import Hero from "../components/Hero.astro";
import HingeDivider from "../components/HingeDivider.astro";
import Features from "../components/Features.astro";
import Downloads from "../components/Downloads.astro";
import DSDevice from "../components/DSDevice.astro";
---

<Layout title="melonDS — a Nintendo DS emulator">
  <RedesignNotice />
  <SiteHeader />
  <main>
    <div class="stage">
      <div class="stage__content">
        <Hero />
        <HingeDivider />
        <Features />
        <HingeDivider />
        <Downloads />
      </div>
      <div class="stage__visual">
        <DSDevice />
      </div>
    </div>
  </main>
  <SiteFooter />
</Layout>

<style>
  .stage {
    display: grid;
    grid-template-columns: 1fr;
  }

  @media (max-width: 1023.98px) {
    /* Hoists the device above the content it's meant to be pinned over —
       otherwise, as the second element in document order, it would render
       below all three sections on a single-column mobile layout. */
    .stage__visual {
      order: -1;
      padding: 1.5rem var(--gutter) 0;
    }
  }

  @media (min-width: 1024px) {
    .stage {
      grid-template-columns: 1fr 32rem;
    }

    /* Stretched (not align-items: start) so this grid item's own box spans
       the full row height — the sticky device inside needs a tall enough
       containing block to travel within, or it runs out of room to stick
       to after one screen's worth of scroll and scrolls away with it. */
    .stage__visual {
      padding: 3rem var(--gutter) 3rem 0;
    }
  }
</style>
